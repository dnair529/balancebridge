<% layout('../layout') %>
<%
  const q = it.user.role === 'client' ? '' : (it.query.client ? '?client=' + it.query.client : '');
%>

<div class="m-page" data-bb-capture-root data-endpoint="/api/pwa/upload">
  <input type="hidden" id="bb-csrf" value="<%= it.csrf %>">

  <div class="page-head">
    <h1>What we need</h1>
    <p class="sub">
      <% if (it.total === 0) { %>
        Nothing outstanding. We have everything we asked for.
      <% } else { %>
        <%= it.total %> item<%= it.total === 1 ? '' : 's' %>. A photo is enough for any of them —
        no scanning, no email.
      <% } %>
    </p>
  </div>

  <div class="m-queue-head" id="bb-queue-head" hidden>
    <h2>Sending</h2>
    <button class="btn btn-ghost btn-sm" type="button" id="bb-queue-retry">Retry all</button>
  </div>
  <ul class="m-queue" id="bb-queue"></ul>

  <% if (it.total === 0) { %>
    <section class="m-empty-hero">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/>
      </svg>
      <p class="m-empty-title">Nothing needed from you right now.</p>
      <p class="m-empty-sub">When a statement or a receipt goes missing, it shows up here — and only here. One list, not a stack of emails.</p>
      <a class="btn btn-ghost" href="/m<%= q %>">Back to home</a>
    </section>
  <% } %>

  <% it.groups.forEach(function (group) { %>
    <section class="m-group">
      <div class="m-group-head">
        <h2><%= group.title %></h2>
        <span class="chip"><%= group.items.length %></span>
      </div>
      <p class="m-group-blurb"><%= group.blurb %></p>

      <ul class="m-needs">
        <% group.items.forEach(function (item) { %>
          <li class="m-need">
            <div class="m-need-body">
              <p class="m-need-title"><%= item.label %></p>
              <p class="m-need-meta muted small">
                Asked <%= it.fmtDate(item.createdAt) %>
                <% if (item.dueAt) { %> · needed by <%= it.fmtDate(item.dueAt) %><% } %>
                <% if (item.nudgeCount > 0) { %> · reminded <%= item.nudgeCount %>×<% } %>
              </p>
            </div>
            <div class="m-need-actions">
              <label class="m-mini-snap" for="cap-<%= item.id %>">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8.5A1.5 1.5 0 014.5 7h2.2l1.2-2h8.2l1.2 2h2.2A1.5 1.5 0 0121 8.5v9A1.5 1.5 0 0119.5 19h-15A1.5 1.5 0 013 17.5z"/>
                  <circle cx="12" cy="13" r="3.5"/>
                </svg>
                <span>Snap it</span>
                <input id="cap-<%= item.id %>" type="file" accept="image/*" capture="environment" multiple
                       data-bb-capture data-note="<%= item.label %>">
              </label>
              <a class="m-mini-link" href="/documents<%= q %>">Upload a file</a>
            </div>
          </li>
        <% }) %>
      </ul>
    </section>
  <% }) %>
</div>

<script src="/assets/pwa/queue.js" defer></script>
<script src="/assets/pwa/capture.js" defer></script>
