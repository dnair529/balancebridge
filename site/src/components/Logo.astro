---
interface Props { variant?: 'light' | 'dark'; class?: string }
const { variant = 'dark', class: className = '' } = Astro.props;
// variant = color of the *text/strokes*: 'light' for dark backgrounds
const strokeColor = variant === 'light' ? '#FFFFFF' : '#0B1F33';
const subColor = variant === 'light' ? '#8B99AB' : '#526175';
const uid = variant === 'light' ? 'l' : 'd';
---
<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg width="34" height="34" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id={`bbArc-${uid}`} x1="8" y1="44" x2="56" y2="44" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color={variant === 'light' ? '#34D399' : '#10B981'} />
        <stop offset="1" stop-color="#2DD4BF" />
      </linearGradient>
    </defs>
    <path d="M8 45 Q32 10 56 45" stroke={`url(#bbArc-${uid})`} stroke-width="6" stroke-linecap="round" />
    <path d="M20 34.6 V45" stroke={strokeColor} stroke-width="6" stroke-linecap="round" />
    <path d="M44 34.6 V45" stroke={strokeColor} stroke-width="6" stroke-linecap="round" />
    <path d="M6 55 H58" stroke={strokeColor} stroke-width="6" stroke-linecap="round" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-[19px] font-semibold tracking-tight" style={`color:${strokeColor};font-family:var(--font-display)`}>Balance&nbsp;Bridge</span>
    <span class="text-[10px] font-medium tracking-[0.22em] uppercase mt-1" style={`color:${subColor}`}>Financial</span>
  </span>
</span>
