---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import FAQ from '../../components/FAQ.astro';
import { INDUSTRIES } from '../../data/industries';
import { SERVICES } from '../../data/services';
import { BUSINESS, CTA } from '../../config';

export function getStaticPaths() {
  return INDUSTRIES.map((ind) => ({ params: { slug: ind.slug }, props: { ind } }));
}
const { ind } = Astro.props;
const services = SERVICES.filter((s) => ind.serviceSlugs.includes(s.slug));
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: BUSINESS.url },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: `${BUSINESS.url}/industries/` },
    { '@type': 'ListItem', position: 3, name: ind.name, item: `${BUSINESS.url}/industries/${ind.slug}/` },
  ],
};
---
<Base title={ind.metaTitle} description={ind.metaDescription} schema={[breadcrumb]}>
  <section class="relative overflow-hidden bg-navy">
    <div class="arc-glow absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
      <nav aria-label="Breadcrumb" class="text-[13px] text-steel-400" data-reveal>
        <a href="/" class="hover:text-white">Home</a> <span class="mx-1.5">/</span>
        <a href="/industries/" class="hover:text-white">Industries</a> <span class="mx-1.5">/</span>
        <span class="text-white/80">{ind.name}</span>
      </nav>
      <div class="mt-6 flex items-start gap-5">
        <span class="hidden rounded-2xl bg-white/8 p-4 text-accent-400 ring-1 ring-white/10 md:inline-flex"><Icon name={ind.icon} size={30} /></span>
        <div>
          <h1 class="max-w-3xl font-display text-[34px] font-semibold leading-[1.12] tracking-tight text-white md:text-5xl" data-reveal style="--reveal-delay:70ms">{ind.title}</h1>
          <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-steel-400" data-reveal style="--reveal-delay:140ms">{ind.heroSub}</p>
          <a href={CTA.primaryHref} class="btn-primary mt-8" data-reveal style="--reveal-delay:200ms">{CTA.primary} <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>The reality</p>
      <h2 class="mt-3 font-display text-[28px] font-semibold tracking-tight text-navy" data-reveal style="--reveal-delay:60ms">Where {ind.name.toLowerCase()} books go wrong</h2>
    </div>
    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      {ind.pains.map((p, i) => (
        <li class="card flex items-start gap-3.5 p-6 text-[15px] leading-relaxed text-steel" data-reveal style={`--reveal-delay:${(i % 2) * 70}ms`}>
          <span class="mt-1 shrink-0 rounded-full bg-red-50 p-1 text-red-400"><Icon name="x" size={13} /></span>
          {p}
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-mist/60 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 class="font-display text-[28px] font-semibold tracking-tight text-navy" data-reveal>How we set your books up instead</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {ind.howWeHelp.map((h, i) => (
          <div class="card p-7" data-reveal style={`--reveal-delay:${(i % 2) * 70}ms`}>
            <span class="inline-flex rounded-lg bg-accent/12 p-2 text-accent-600"><Icon name="check" size={17} /></span>
            <h3 class="mt-4 font-display text-[17px] font-semibold text-navy">{h.title}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-steel">{h.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
    <h2 class="font-display text-[28px] font-semibold tracking-tight text-navy" data-reveal>Most-used services in {ind.name.toLowerCase()}</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s, i) => (
        <a href={`/services/${s.slug}/`} class="card card-hover group p-6" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <Icon name={s.icon} size={21} class="text-accent-600" />
          <h3 class="mt-3.5 font-display text-[15px] font-semibold text-navy">{s.name}</h3>
          <p class="mt-1.5 text-[13px] leading-relaxed text-steel">{s.oneLiner}</p>
        </a>
      ))}
    </div>
  </section>

  {ind.faqs.length > 0 && (
    <section class="mx-auto max-w-4xl px-5 pb-16 lg:pb-24">
      <h2 class="font-display text-[28px] font-semibold tracking-tight text-navy" data-reveal>FAQs from {ind.name.toLowerCase()} owners</h2>
      <FAQ items={ind.faqs} class="mt-8" withSchema />
    </section>
  )}

  <CTABand title={`Ready for books built for ${ind.name.toLowerCase()}?`} />
</Base>
