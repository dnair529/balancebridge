{
  "name": "balancebridge-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Balance Bridge Financial client portal (portal.balancebridge.us)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "mkdir -p dist/views && cp -r src/views/. dist/views/",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.2",
    "eta": "^3.5.0",
    "fastify": "^5.3.2",
    "nodemailer": "^7.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "stripe": "^18.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
