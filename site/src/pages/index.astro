---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import { BUSINESS, CTA } from '../config';
import { SERVICES } from '../data/services';
import { INDUSTRIES } from '../data/industries';
import { TESTIMONIALS } from '../data/social-proof';
import { FAQS } from '../data/faqs';

const steps = [
  { n: '01', title: 'Free books review', text: `A 20-minute call plus a look at your current books. You get a plain-English assessment of what's working, what's broken, and what it costs to fix — whether or not you hire us.` },
  { n: '02', title: 'Cleanup & takeover', text: `We reconcile every account, fix the chart of accounts, and catch up any backlog. Most businesses are fully caught up and running clean within 2–4 weeks.` },
  { n: '03', title: 'Your monthly rhythm', text: `Books closed on schedule, reports in your inbox, and a team that answers questions in plain English. You always know where you stand.` },
];
const pains = [
  { icon: 'clock', title: `You're always behind`, text: `Receipts pile up, reconciliations slip, and "I'll catch up this weekend" never happens. Every month behind makes tax season worse.` },
  { icon: 'chart', title: `You're flying blind`, text: `Revenue is decent but you don't actually know your margins, your runway, or which jobs make money. Decisions run on gut feel.` },
  { icon: 'file-check', title: `Tax season is a scramble`, text: `Your CPA asks for clean books; you send a shoebox. You overpay for cleanup at the worst time of year — or overpay in taxes.` },
];
const homeFaqs = FAQS.filter((f) => ['Getting started', 'Pricing'].includes(f.category)).slice(0, 5);
---
<Base
  title="Bookkeeping & Accounting for Texas Small Businesses | Balance Bridge"
  description="Modern bookkeeping, payroll support, and CFO advisory for Texas small businesses. Clean books by the 10th, plain-English reports, fixed monthly pricing. Free consultation."
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-navy">
    <div class="arc-glow absolute inset-0" aria-hidden="true"></div>
    <svg class="absolute -bottom-24 left-1/2 -translate-x-1/2 opacity-[0.16]" width="1400" height="500" viewBox="0 0 1400 500" fill="none" aria-hidden="true">
      <path d="M0 500 Q700 40 1400 500" stroke="#34D399" stroke-width="1.5" />
      <path d="M100 500 Q700 140 1300 500" stroke="#2DD4BF" stroke-width="1" opacity="0.6" />
    </svg>
    <div class="relative mx-auto max-w-7xl px-5 pb-24 pt-20 lg:px-8 lg:pb-32 lg:pt-28">
      <div class="max-w-3xl">
        <p class="eyebrow-dark flex items-center gap-2" data-reveal>
          <Icon name="map-pin" size={15} /> Texas-based · Serving businesses statewide
        </p>
        <h1 class="mt-5 font-display text-[40px] font-semibold leading-[1.06] tracking-tight text-white md:text-6xl lg:text-[64px]" data-reveal style="--reveal-delay:70ms">
          Your books, balanced.<br />
          <span class="bg-gradient-to-r from-accent-400 to-tealx bg-clip-text text-transparent">Your next move, clear.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-steel-400 md:text-[19px]" data-reveal style="--reveal-delay:140ms">
          Balance Bridge handles the bookkeeping, payroll support, and reporting — so you run your business on real numbers instead of gut feel. Books closed by the 10th, every month.
        </p>
        <div class="mt-9 flex flex-col gap-3.5 sm:flex-row" data-reveal style="--reveal-delay:210ms">
          <a href={CTA.primaryHref} class="btn-primary">{CTA.primary} <Icon name="arrow-right" size={17} /></a>
          <a href="/pricing/" class="btn-ghost-dark">See transparent pricing</a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-[13.5px] font-medium text-white/60" data-reveal style="--reveal-delay:280ms">
          <li class="flex items-center gap-2"><Icon name="check" size={15} class="text-accent-400" /> QuickBooks ProAdvisor</li>
          <li class="flex items-center gap-2"><Icon name="check" size={15} class="text-accent-400" /> Flat monthly pricing</li>
          <li class="flex items-center gap-2"><Icon name="check" size={15} class="text-accent-400" /> {BUSINESS.replyPromise.toLowerCase()}</li>
          <li class="flex items-center gap-2"><Icon name="check" size={15} class="text-accent-400" /> No long-term contracts</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ INDUSTRY STRIP ============ -->
  <section class="border-b border-navy/8 bg-white">
    <div class="mx-auto max-w-7xl px-5 py-7 lg:px-8">
      <p class="text-center text-[12.5px] font-semibold uppercase tracking-[0.16em] text-steel-400">Trusted by owner-run businesses across Texas</p>
      <ul class="mt-4 flex flex-wrap items-center justify-center gap-x-9 gap-y-2.5">
        {INDUSTRIES.map((i) => (
          <li><a href={`/industries/${i.slug}/`} class="flex items-center gap-2 text-[14px] font-medium text-steel transition-colors hover:text-accent-600"><Icon name={i.icon} size={16} /> {i.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ PROBLEM → PROMISE ============ -->
  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>Sound familiar?</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-navy md:text-[40px] md:leading-[1.15]" data-reveal style="--reveal-delay:70ms">
        Most owners don't have a numbers problem. They have a bookkeeping problem.
      </h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {pains.map((p, i) => (
        <div class="card card-hover p-7" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <span class="inline-flex rounded-xl bg-mist p-3 text-navy"><Icon name={p.icon as any} size={22} /></span>
          <h3 class="mt-5 font-display text-lg font-semibold text-navy">{p.title}</h3>
          <p class="mt-2.5 text-[14.5px] leading-relaxed text-steel">{p.text}</p>
        </div>
      ))}
    </div>
    <p class="mt-10 max-w-2xl text-[16.5px] leading-relaxed text-steel" data-reveal>
      We fix all three — with a monthly rhythm that keeps books current, reports you actually read, and answers when you need them. <a href="/about/" class="font-semibold text-accent-600 underline underline-offset-4 hover:text-accent">Here's how we work →</a>
    </p>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="bg-mist/60 py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow" data-reveal>What we do</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-navy md:text-[40px]" data-reveal style="--reveal-delay:70ms">Everything your back office needs. Nothing it doesn't.</h2>
        </div>
        <a href="/services/" class="btn-ghost-light hidden md:inline-flex" data-reveal>All services <Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {SERVICES.map((s, i) => (
          <a href={`/services/${s.slug}/`} class="card card-hover group flex flex-col p-6" data-reveal style={`--reveal-delay:${(i % 5) * 60}ms`}>
            <Icon name={s.icon} size={22} class="text-accent-600" />
            <h3 class="mt-4 font-display text-[15.5px] font-semibold leading-snug text-navy">{s.name}</h3>
            <p class="mt-2 flex-1 text-[13px] leading-relaxed text-steel">{s.oneLiner}</p>
            <span class="mt-4 flex items-center gap-1.5 text-[13px] font-semibold text-accent-600 transition-transform duration-200 group-hover:translate-x-0.5">Learn more <Icon name="arrow-right" size={13} /></span>
          </a>
        ))}
      </div>
      <a href="/services/" class="btn-ghost-light mt-8 w-full md:hidden">All services <Icon name="arrow-right" size={16} /></a>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>How it works</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-navy md:text-[40px]" data-reveal style="--reveal-delay:70ms">From messy books to monthly clarity in three steps</h2>
    </div>
    <div class="relative mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
      <div class="absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-accent/0 via-accent/40 to-accent/0 md:block" aria-hidden="true"></div>
      {steps.map((s, i) => (
        <div class="relative" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="relative z-10 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-navy font-display text-[15px] font-semibold text-accent-400 shadow-lg">{s.n}</span>
          <h3 class="mt-5 font-display text-xl font-semibold text-navy">{s.title}</h3>
          <p class="mt-2.5 max-w-sm text-[15px] leading-relaxed text-steel">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ PROOF ============ -->
  <section class="relative overflow-hidden bg-navy py-20 lg:py-28">
    <div class="arc-glow absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-10 text-center sm:grid-cols-3">
        <div data-reveal>
          <p class="font-display text-5xl font-semibold text-white"><span data-countup="10" data-suffix="th">10th</span></p>
          <p class="mt-2 text-[14.5px] text-steel-400">of the month — your books are closed and reports delivered</p>
        </div>
        <div data-reveal style="--reveal-delay:80ms">
          <p class="font-display text-5xl font-semibold text-white"><span data-countup="24" data-suffix="hr">24hr</span></p>
          <p class="mt-2 text-[14.5px] text-steel-400">response promise on every client question, in plain English</p>
        </div>
        <div data-reveal style="--reveal-delay:160ms">
          <p class="font-display text-5xl font-semibold text-white"><span data-countup="100" data-suffix="%">100%</span></p>
          <p class="mt-2 text-[14.5px] text-steel-400">reconciled, every account, every month — no "close enough"</p>
        </div>
      </div>
      <div class="mt-16 grid gap-5 md:grid-cols-3">
        {TESTIMONIALS.slice(0, 3).map((t, i) => (
          <figure class="rounded-2xl bg-white/[0.05] p-7 ring-1 ring-white/10" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <div class="flex gap-1 text-accent-400" aria-label="5 star rating">
              {Array.from({ length: 5 }).map(() => <Icon name="star" size={14} />)}
            </div>
            <blockquote class="mt-4 text-[15px] leading-relaxed text-white/85">"{t.quote}"</blockquote>
            <figcaption class="mt-5 text-[13.5px] text-steel-400"><span class="font-semibold text-white/80">{t.name}</span> · {t.role}, {t.company}</figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-6 text-center text-[12px] text-white/35">Illustrative client experiences shown; replaced with verified reviews at launch.</p>
    </div>
  </section>

  <!-- ============ LEAD MAGNET ============ -->
  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24">
    <div class="card overflow-hidden lg:grid lg:grid-cols-[1.2fr_1fr]">
      <div class="p-9 lg:p-12">
        <p class="eyebrow" data-reveal>Free download</p>
        <h2 class="mt-3 font-display text-2xl font-semibold tracking-tight text-navy md:text-3xl" data-reveal style="--reveal-delay:60ms">The Texas Small Business Financial Health Checklist</h2>
        <p class="mt-3.5 max-w-lg text-[15.5px] leading-relaxed text-steel" data-reveal style="--reveal-delay:120ms">
          20 checks that tell you in 15 minutes whether your books would survive a loan application, a tax audit, or a serious buyer. No email chase, no fluff.
        </p>
        <a href={CTA.leadMagnetHref} class="btn-primary mt-7" data-reveal style="--reveal-delay:180ms">{CTA.leadMagnet} <Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="relative hidden items-center justify-center bg-navy lg:flex">
        <div class="arc-glow absolute inset-0" aria-hidden="true"></div>
        <div class="relative m-10 w-full max-w-[280px] rounded-xl bg-white p-6 shadow-2xl">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-accent"></span>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-steel-400">Checklist preview</span>
          </div>
          {['All bank accounts reconciled', 'AR aging under control', 'Sales tax filings current', 'P&L reviewed monthly'].map((item, idx) => (
            <div class="mt-3.5 flex items-center gap-2.5 text-[13px] text-navy">
              <span class={`flex h-5 w-5 items-center justify-center rounded ${idx < 3 ? 'bg-accent text-white' : 'ring-1 ring-navy/20'}`}>{idx < 3 && <Icon name="check" size={12} />}</span>
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ TEASER ============ -->
  <section class="mx-auto max-w-4xl px-5 pb-20 lg:pb-28">
    <h2 class="text-center font-display text-3xl font-semibold tracking-tight text-navy" data-reveal>Questions owners ask us first</h2>
    <FAQ items={homeFaqs} class="mt-10" withSchema />
    <p class="mt-7 text-center text-[15px] text-steel">More questions? <a href="/faq/" class="font-semibold text-accent-600 underline underline-offset-4">Read all FAQs</a> or <a href="/contact/" class="font-semibold text-accent-600 underline underline-offset-4">just ask us</a>.</p>
  </section>

  <CTABand />
</Base>
