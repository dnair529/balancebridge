<%
  const staff = it.user && (it.user.role === 'staff' || it.user.role === 'admin');
  const q = (!it.user || it.user.role === 'client') ? '' :
    (it.query && it.query.client ? '?client=' + it.query.client : '');
  // Nav is split by role deliberately: nine tabs do not fit at 375px, and the
  // two audiences want different things. Clients live in capture and answers;
  // staff live in the work queue.
  const I = {
    dashboard: 'M3 12l9-8 9 8M5 10v10h5v-6h4v6h5V10',
    capture: 'M3 8.5A1.5 1.5 0 014.5 7h2.2l1.2-2h8.2l1.2 2h2.2A1.5 1.5 0 0121 8.5v9A1.5 1.5 0 0119.5 19h-15A1.5 1.5 0 013 17.5zM12 16.5a3.5 3.5 0 100-7 3.5 3.5 0 000 7z',
    questions: 'M12 21a9 9 0 100-18 9 9 0 000 18M9.5 9.5a2.5 2.5 0 015 0c0 1.7-2.5 1.8-2.5 3.5M12 17h.01',
    needs: 'M3 13h4l2 3h6l2-3h4M3 13l3-8h12l3 8v5a1 1 0 01-1 1H4a1 1 0 01-1-1z',
    insights: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
    documents: 'M6 2h8l4 4v16H6zM14 2v5h5',
    messages: 'M4 5h16v11H8l-4 4z',
    tasks: 'M4 6h2v2H4zM9 7h11M4 11h2v2H4zM9 12h11M4 16h2v2H4zM9 17h11',
    billing: 'M3 6h18v12H3zM3 10h18',
    signatures: 'M3 17c3 0 3-8 6-8s2 10 5 10 2-6 7-6M3 21h18',
    workspace: 'M4 7h16v13H4zM9 7V4h6v3M4 12h16',
    settings: 'M12 8a4 4 0 100 8 4 4 0 000-8zM12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1',
  };
  const items = staff ? [
    ['/workspace', 'Workspace', I.workspace],
    ['/dashboard', 'Dashboard', I.dashboard],
    ['/documents', 'Documents', I.documents],
    ['/messages', 'Messages', I.messages],
    ['/tasks', 'Tasks', I.tasks],
    ['/billing', 'Billing', I.billing],
    ['/settings', 'Settings', I.settings],
  ] : [
    ['/m', 'Capture', I.capture],
    ['/questions', 'Questions', I.questions],
    ['/needs', 'Needs', I.needs],
    ['/insights', 'Insights', I.insights],
    ['/documents', 'Documents', I.documents],
    ['/messages', 'Messages', I.messages],
    ['/billing', 'Billing', I.billing],
    ['/signatures', 'Signatures', I.signatures],
    ['/settings', 'Settings', I.settings],
  ];
%>
<% items.forEach(function (item) { %>
  <a class="nav-link<%= it.path === item[0] || (it.path || '').startsWith(item[0] + '/') ? ' active' : '' %>" href="<%= item[0] + q %>">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="<%= item[2] %>"/></svg>
    <span><%= item[1] %></span>
  </a>
<% }) %>
<% if (staff) { %>
  <a class="nav-link nav-admin<%= (it.path || '').startsWith('/admin') ? ' active' : '' %>" href="/admin">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/></svg>
    <span>Admin</span>
  </a>
<% } %>
