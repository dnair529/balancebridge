---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import { SERVICES } from '../../data/services';
---
<Base
  title="Bookkeeping & Accounting Services in Texas | Balance Bridge"
  description="Monthly bookkeeping, payroll support, QuickBooks cleanup, financial reporting, and CFO advisory for Texas small businesses. See all 10 services."
>
  <section class="relative overflow-hidden bg-navy">
    <div class="arc-glow absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
      <p class="eyebrow-dark" data-reveal>Services</p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold tracking-tight text-white md:text-5xl" data-reveal style="--reveal-delay:70ms">One team for your entire back office</h1>
      <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-steel-400" data-reveal style="--reveal-delay:140ms">
        Start with clean monthly books, add what you need as you grow — payroll support, cash-flow forecasting, controller oversight, or a fractional CFO. Every service, one accountable team.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
    <div class="grid gap-5 md:grid-cols-2">
      {SERVICES.map((s, i) => (
        <a href={`/services/${s.slug}/`} class="card card-hover group flex items-start gap-5 p-7" data-reveal style={`--reveal-delay:${(i % 2) * 70}ms`}>
          <span class="inline-flex shrink-0 rounded-xl bg-mist p-3.5 text-navy transition-colors group-hover:bg-accent group-hover:text-white"><Icon name={s.icon} size={24} /></span>
          <span>
            <h2 class="font-display text-lg font-semibold text-navy">{s.name}</h2>
            <p class="mt-1.5 text-[14.5px] leading-relaxed text-steel">{s.oneLiner}</p>
            <span class="mt-3 flex items-center gap-1.5 text-[13.5px] font-semibold text-accent-600">Learn more <Icon name="arrow-right" size={14} class="transition-transform duration-200 group-hover:translate-x-0.5" /></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <CTABand title="Not sure which services you need?" sub="That's exactly what the free consultation is for. Tell us where your books stand and we'll map the shortest path to clean, useful numbers." />
</Base>
