---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import FAQ from '../../components/FAQ.astro';
import { SERVICES } from '../../data/services';
import { INDUSTRIES } from '../../data/industries';
import { BUSINESS, CTA } from '../../config';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const related = SERVICES.filter((x) => s.related.includes(x.slug));
const industries = INDUSTRIES.filter((x) => s.industrySlugs.includes(x.slug));

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: BUSINESS.url },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${BUSINESS.url}/services/` },
    { '@type': 'ListItem', position: 3, name: s.name, item: `${BUSINESS.url}/services/${s.slug}/` },
  ],
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  description: s.metaDescription,
  provider: { '@id': `${BUSINESS.url}/#org` },
  areaServed: { '@type': 'State', name: 'Texas' },
  serviceType: s.name,
};
---
<Base title={s.metaTitle} description={s.metaDescription} schema={[breadcrumb, serviceSchema]}>
  <section class="relative overflow-hidden bg-navy">
    <div class="arc-glow absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
      <nav aria-label="Breadcrumb" class="text-[13px] text-steel-400" data-reveal>
        <a href="/" class="hover:text-white">Home</a> <span class="mx-1.5">/</span>
        <a href="/services/" class="hover:text-white">Services</a> <span class="mx-1.5">/</span>
        <span class="text-white/80">{s.name}</span>
      </nav>
      <div class="mt-6 flex items-start gap-5">
        <span class="hidden rounded-2xl bg-white/8 p-4 text-accent-400 ring-1 ring-white/10 md:inline-flex"><Icon name={s.icon} size={30} /></span>
        <div>
          <h1 class="max-w-3xl font-display text-[34px] font-semibold leading-[1.12] tracking-tight text-white md:text-5xl" data-reveal style="--reveal-delay:70ms">{s.title}</h1>
          <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-steel-400" data-reveal style="--reveal-delay:140ms">{s.heroSub}</p>
          <div class="mt-8 flex flex-col gap-3.5 sm:flex-row" data-reveal style="--reveal-delay:200ms">
            <a href={CTA.primaryHref} class="btn-primary">{CTA.primary} <Icon name="arrow-right" size={16} /></a>
            <a href="/pricing/" class="btn-ghost-dark">{s.priceAnchor}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <p class="eyebrow" data-reveal>Is this you?</p>
        <h2 class="mt-3 font-display text-[28px] font-semibold tracking-tight text-navy" data-reveal style="--reveal-delay:60ms">Signs you need this</h2>
        <ul class="mt-7 space-y-4">
          {s.symptoms.map((sym, i) => (
            <li class="flex items-start gap-3.5 text-[15.5px] leading-relaxed text-steel" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <span class="mt-1 shrink-0 rounded-full bg-red-50 p-1 text-red-400"><Icon name="x" size={13} /></span>
              {sym}
            </li>
          ))}
        </ul>
      </div>
      <div class="card h-fit bg-mist/50 p-8 lg:p-9">
        <h2 class="font-display text-[22px] font-semibold tracking-tight text-navy">What's included</h2>
        <ul class="mt-6 space-y-3.5">
          {s.included.map((inc) => (
            <li class="flex items-start gap-3 text-[15px] leading-relaxed text-navy/85">
              <span class="mt-0.5 shrink-0 rounded-full bg-accent/15 p-1 text-accent-600"><Icon name="check" size={13} /></span>
              {inc}
            </li>
          ))}
        </ul>
        <a href={CTA.quoteHref} class="btn-primary mt-8 w-full">{CTA.quote}</a>
        <p class="mt-3 text-center text-[13px] text-steel">{s.priceAnchor} · quoted after a free review</p>
      </div>
    </div>
  </section>

  <section class="bg-mist/60 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 class="font-display text-[28px] font-semibold tracking-tight text-navy" data-reveal>How it works</h2>
      <div class={`mt-10 grid gap-8 ${s.steps.length === 4 ? 'md:grid-cols-4' : 'md:grid-cols-3'}`}>
        {s.steps.map((st, i) => (
          <div class="relative" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-navy font-display text-[14px] font-semibold text-accent-400">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 font-display text-[17px] font-semibold text-navy">{st.title}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-steel">{st.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-16 lg:py-24">
    <h2 class="font-display text-[28px] font-semibold tracking-tight text-navy" data-reveal>Common questions</h2>
    <FAQ items={s.faqs} class="mt-8" withSchema />
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-16 lg:px-8 lg:pb-24">
    <div class="rounded-2xl bg-mist/60 p-8 lg:p-10">
      <div class="grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="font-display text-lg font-semibold text-navy">Often paired with</h2>
          <ul class="mt-4 space-y-2.5">
            {related.map((r) => (
              <li><a href={`/services/${r.slug}/`} class="flex items-center gap-2.5 text-[15px] font-medium text-accent-600 hover:text-accent"><Icon name={r.icon} size={16} /> {r.name}</a></li>
            ))}
            <li><a href="/pricing/" class="flex items-center gap-2.5 text-[15px] font-medium text-accent-600 hover:text-accent"><Icon name="dollar" size={16} /> See plans & pricing</a></li>
          </ul>
        </div>
        <div>
          <h2 class="font-display text-lg font-semibold text-navy">Industries we serve with this</h2>
          <ul class="mt-4 space-y-2.5">
            {industries.map((ind) => (
              <li><a href={`/industries/${ind.slug}/`} class="flex items-center gap-2.5 text-[15px] font-medium text-accent-600 hover:text-accent"><Icon name={ind.icon} size={16} /> {ind.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CTABand />
</Base>
