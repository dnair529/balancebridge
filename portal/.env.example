# ------------------------------------------------------------------
# Balance Bridge portal — environment
# Copy to .env and fill in. NEVER commit .env.
# ------------------------------------------------------------------

# --- Runtime ---
# development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# pino level: trace|debug|info|warn|error
LOG_LEVEL=info

# --- Database ---
# PostgreSQL 16 connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portal

# --- Sessions / crypto ---
# Server-side pepper mixed into session/reset/invite token hashes and used
# as the cookie-signing secret. >= 32 chars of randomness. Rotating it
# invalidates all outstanding sessions and emailed tokens.
SESSION_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# "1" (default) sets Secure cookies and uses the __Host-session cookie name.
# Set to "0" ONLY for local plain-HTTP development (curl/localhost).
COOKIE_SECURE=0

# --- URLs ---
# Marketing site origin; /api/leads redirects to ${SITE_URL}/thanks/ on success.
SITE_URL=https://balancebridge.us
# This app's own public origin (used in emails).
PORTAL_URL=http://localhost:3000
# Extra origins allowed to POST /api/leads (comma separated). The production
# site origins + localhost dev are always allowed.
LEADS_EXTRA_ORIGINS=

# --- Uploads ---
# Absolute or relative dir OUTSIDE the web root. Created on boot if missing.
UPLOADS_DIR=./data/uploads

# --- Seed (src/db/seed.ts) ---
# Admin user created (idempotently) by the seed script.
ADMIN_EMAIL=admin@balancebridge.us
ADMIN_PASSWORD=change-me-strong-password
# "1" also creates a demo client, demo client user, and sample data.
SEED_DEMO=0
# Password for the demo client user (only used when SEED_DEMO=1).
DEMO_PASSWORD=demo-client-password

# --- Stripe (optional in dev; billing sync/webhooks disabled when empty) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- DocuSeal (optional in dev; e-signature disabled when empty) ---
# Self-hosted DocuSeal origin, e.g. https://sign.balancebridge.us
DOCUSEAL_URL=
DOCUSEAL_API_KEY=
# Shared secret the portal expects in the X-Docuseal-Secret header on webhooks.
DOCUSEAL_WEBHOOK_SECRET=

# --- SMTP (optional; when SMTP_HOST is empty mail is logged to console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "1" = TLS from the first byte (port 465); otherwise STARTTLS is used.
SMTP_SECURE=0
MAIL_FROM="Balance Bridge Financial <no-reply@balancebridge.us>"
# Firm inbox that receives new-lead alerts.
FIRM_INBOX=hello@balancebridge.us

# ------------------------------------------------------------------
# --- File encryption at rest (src/lib/crypto.ts) ---
# ------------------------------------------------------------------
# Master key (KEK) that wraps every uploaded file's per-file data key.
# base64 for exactly 32 bytes. Generate with:  openssl rand -base64 32
#
# REQUIRED IN PRODUCTION — the app refuses to boot without it, and refuses
# to boot with the dev placeholder. Leaving it empty outside production
# falls back to a fixed, PUBLIC dev key, so dev uploads are NOT secret.
#
# LOSING THIS KEY MEANS LOSING EVERY UPLOADED DOCUMENT. Keep a copy in the
# password manager, not only on the VPS. See docs/SECURITY.md.
FILE_ENCRYPTION_KEY=
# Previous KEK, set ONLY during a key rotation window. New files are always
# written with FILE_ENCRYPTION_KEY; files still sealed with the old key stay
# readable while `reencryptStored()` works through the backlog. Clear it when
# the rotation is done (the app refuses to start if it equals the current key).
FILE_ENCRYPTION_KEY_PREVIOUS=

# ------------------------------------------------------------------
# --- Database roles / row-level security (src/db/rls.sql) ---
# ------------------------------------------------------------------
# Owner-privileged connection used ONLY by migrations and apply-rls.
# Leave empty to reuse DATABASE_URL. Set it once DATABASE_URL points at the
# restricted app role below, so the app keeps its reduced privileges.
ADMIN_DATABASE_URL=
# Non-superuser, non-owner role the app should connect as in production.
# Created/repaired idempotently every time migrations run.
APP_DB_ROLE=portal_app
# Password set on APP_DB_ROLE when it is created. Empty = leave the existing
# password alone (manage it out of band). Whatever you set here must match the
# password in DATABASE_URL once you switch over.
APP_DB_PASSWORD=

# ------------------------------------------------------------------
# --- MFA policy (src/lib/mfa-policy.ts) ---
# ------------------------------------------------------------------
# Staff/admin accounts can reach EVERY client's records, so TOTP is mandatory
# for them. Anything other than the literal "0" enforces it; a typo fails
# safe (enforced). Client accounts are unaffected — TOTP stays optional there.
REQUIRE_STAFF_MFA=1

# ------------------------------------------------------------------
# --- Data retention, in days (src/lib/retention.ts) ---
# ------------------------------------------------------------------
# Run:  node dist/lib/retention.js            # dry run, prints a report
#       node dist/lib/retention.js --apply    # actually delete
# Revoked/expired sessions.
RETENTION_SESSIONS_DAYS=90
# audit_log — financial records, 7 years. 2555 is a HARD FLOOR: a lower value
# is rejected by config parsing and again by the purge itself.
RETENTION_AUDIT_DAYS=2555
# Leads that were never handled (handled leads are kept — they became clients).
RETENTION_LEADS_DAYS=730
# Quarantined intake items nobody claimed; their encrypted blobs go too.
RETENTION_INTAKE_QUARANTINE_DAYS=180
# The outbound message send log.
RETENTION_OUTBOUND_DAYS=730

# ------------------------------------------------------------------
# --- Off-box backups (infra/backup.sh) ---
# ------------------------------------------------------------------
# NOT read by the app. These live in $ENV_DIR/.env.backup on the VPS
# (chmod 600) and are listed here so the full set of secrets is in one place.
#
# BACKUP_PASSPHRASE=              # long random; losing it loses the backups
# BACKUP_REMOTE=bb:bb-backups     # rclone remote:bucket[/prefix]
# RCLONE_CONFIG_BB_TYPE=s3
# RCLONE_CONFIG_BB_PROVIDER=Other
# RCLONE_CONFIG_BB_ACCESS_KEY_ID=
# RCLONE_CONFIG_BB_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_BB_ENDPOINT=      # omit for real AWS S3
# RCLONE_CONFIG_BB_REGION=us-east-1
# BACKUP_LOCAL_RETENTION_DAYS=14
# BACKUP_REMOTE_RETENTION_DAYS=90

# ------------------------------------------------------------------
# --- AI layer (src/ai) ---
# ------------------------------------------------------------------
# Provider-agnostic. `stub` is a deterministic local provider that needs no
# key and produces genuinely usable output — it is the default and the
# portal has no hard dependency on any model vendor.
AI_PROVIDER=stub                  # stub | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Below this confidence (0-100) a suggestion returns needsHuman instead of a
# guess. Default conservative; tune per client over time.
AI_CONFIDENCE_THRESHOLD=75
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0

# ------------------------------------------------------------------
# --- Omnichannel intake (src/intake) ---
# ------------------------------------------------------------------
# Every channel is OPTIONAL. An unconfigured channel reports configured:false,
# refuses to send (typed ChannelNotConfiguredError) and leaves its outbound
# messages queued — it never stops the portal booting.

# Public origin providers call. Webhook signatures are computed over this URL,
# so it must match exactly what Twilio/Meta were given. Defaults to PORTAL_URL.
INTAKE_PUBLIC_BASE_URL=

# --- SMS/MMS + voice notes (Twilio) ---
# Requires US 10DLC brand + campaign registration before production traffic,
# and documented TCPA opt-in per number (channel_identities.consent_at).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                # also the X-Twilio-Signature signing key
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SIGNATURE=1         # never set to 0 outside local replay

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=              # X-Hub-Signature-256 signing key
WHATSAPP_VERIFY_TOKEN=            # GET /webhooks/whatsapp handshake
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0

# --- Inbound email parse hook (Postmark / Mailgun / SendGrid) ---
EMAIL_INBOUND_SECRET=             # sent as X-Intake-Secret; required to accept
EMAIL_INBOUND_DOMAIN=

# --- Not built yet (adapters are stubs; see the TODO in each file) ---
CLOUD_FOLDER_PROVIDER=            # gdrive | dropbox
BANK_FEED_PROVIDER=               # plaid | qbo

# --- Pipeline tuning ---
INTAKE_MATCH_DATE_WINDOW_DAYS=5
INTAKE_MATCH_AMOUNT_TOLERANCE_CENTS=200
INTAKE_MATCH_AUTOFILE_CONFIDENCE=80   # below this a human sees it first
INTAKE_NUDGE_INTERVAL_HOURS=72        # one digest per client per interval
INTAKE_W9_THRESHOLD_CENTS=60000
INTAKE_STATEMENT_LOOKBACK_MONTHS=3
INTAKE_REPLY_MAX_CHARS=320
# users.email the pipeline attributes automated confirmations to.
# Defaults to ADMIN_EMAIL. Must be a staff or admin account.
INTAKE_AUTOMATION_EMAIL=
